---
import initialData from '../data/portfolioData.json';
import crypto from 'node:crypto';

// Password bawaan sistem (dapat diganti kapan saja dari dalam admin panel)
const DEFAULT_PASSWORD = 'AnisahAdmin2026!';
const DEFAULT_PASS_HASH = crypto.createHash('sha256').update(DEFAULT_PASSWORD).digest('hex');
const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '') || '/';
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel CMS | Anisah Rihadatul Aisy Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --bg-app: #F8FAFC;
      --bg-panel: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-main: #0F172A;
      --text-sub: #475569;
      --text-muted: #94A3B8;
      --border: #E2E8F0;
      --primary: #55198b;
      --primary-hover: #8c43ce;
      --primary-soft: #F3E8FF;
      --danger: #DC2626;
      --danger-soft: #FEE2E2;
      --success: #059669;
      --success-soft: #D1FAE5;
      --radius-lg: 14px;
      --radius-md: 9px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-app);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      display: grid;
      grid-template-columns: 280px 1fr;
      min-height: 100vh;
      line-height: 1.55;
    }

    .sidebar {
      background: var(--bg-panel);
      border-right: 1px solid var(--border);
      padding: 24px 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .brand {
      padding: 4px 12px 20px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 16px;
    }

    .brand h2 {
      font-size: 17px;
      font-weight: 700;
      color: var(--primary);
    }

    .brand p {
      font-size: 12px;
      color: var(--text-sub);
      margin-top: 4px;
    }

    .nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .nav-btn {
      width: 100%;
      background: transparent;
      border: none;
      color: var(--text-sub);
      padding: 11px 14px;
      border-radius: var(--radius-md);
      font-family: inherit;
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.2s ease;
    }

    .nav-btn:hover {
      background: var(--bg-subtle);
      color: var(--text-main);
    }

    .nav-btn.active {
      background: var(--primary);
      color: #FFFFFF;
    }

    .count-badge {
      background: rgba(15, 23, 42, 0.08);
      padding: 2px 8px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 700;
    }

    .nav-btn.active .count-badge {
      background: rgba(255, 255, 255, 0.22);
      color: #FFFFFF;
    }

    .workspace {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .topbar {
      height: 70px;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .status-chip {
      background: var(--success-soft);
      color: var(--success);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 700;
    }

    .top-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .btn {
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: var(--radius-md);
      cursor: pointer;
      border: 1px solid transparent;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-outline {
      background: #FFFFFF;
      border-color: var(--border);
      color: var(--text-main);
    }

    .btn-outline:hover {
      background: var(--bg-subtle);
    }

    .btn-edit {
      background: var(--primary-soft);
      color: var(--primary);
      padding: 6px 12px;
      font-size: 12px;
    }

    .btn-edit:hover {
      background: var(--primary);
      color: #FFFFFF;
    }

    .btn-del {
      background: var(--danger-soft);
      color: var(--danger);
      padding: 6px 12px;
      font-size: 12px;
    }

    .btn-del:hover {
      background: var(--danger);
      color: #FFFFFF;
    }

    .content {
      padding: 32px;
      max-width: 1200px;
      width: 100%;
    }

    .cms-sec { display: none; }
    .cms-sec.active { display: block; }

    .sec-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 24px;
      gap: 16px;
      flex-wrap: wrap;
    }

    .sec-head h1 { font-size: 22px; font-weight: 700; }
    .sec-head p { font-size: 13.5px; color: var(--text-sub); margin-top: 4px; }

    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

    .card {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      box-shadow: 0 8px 20px -6px rgba(15, 23, 42, 0.04);
    }

    .pill {
      display: inline-block;
      background: var(--primary-soft);
      color: var(--primary);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .card-title { font-size: 16.5px; font-weight: 700; margin: 8px 0 4px; }
    .card-meta { font-size: 12px; font-weight: 600; color: var(--text-sub); margin-bottom: 6px; }
    .card-desc { font-size: 13px; color: var(--text-sub); }

    .card-foot {
      padding-top: 12px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .seg-bar {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
      height: 9px;
      margin-top: 10px;
    }

    .seg-dash { background: var(--border); border-radius: 4px; }
    .seg-dash.filled { background: var(--primary-hover); }

    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 6px; }
    .input, .textarea, .select {
      width: 100%;
      padding: 10px 12px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--bg-app);
      color: var(--text-main);
      font-family: inherit;
      font-size: 13px;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-backdrop.open { display: flex; }

    .modal-box {
      background: #FFFFFF;
      border-radius: 18px;
      width: min(580px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      padding: 26px;
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 18px;
    }

    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--text-main);
      color: #FFFFFF;
      padding: 12px 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      display: none;
      z-index: 300;
    }
    .toast.show { display: block; }

    @media (max-width: 960px) {
      body { grid-template-columns: 1fr; }
      .sidebar { height: auto; position: relative; }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
    }

    /* AUTH GATEWAY SECURITY STYLES */
    body.is-locked {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      height: 100vh !important;
      overflow: hidden !important;
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%) !important;
    }
    body.is-locked .sidebar,
    body.is-locked .workspace,
    body.is-locked .modal-backdrop,
    body.is-locked #toast {
      display: none !important;
    }
    body:not(.is-locked) #authGate {
      display: none !important;
    }

    .auth-gate {
      width: 100%;
      max-width: 440px;
      padding: 24px;
      margin: auto;
    }

    .auth-card {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      padding: 38px 32px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
      text-align: center;
    }

    .auth-icon {
      width: 64px;
      height: 64px;
      background: var(--primary-soft);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
      box-shadow: 0 0 0 8px rgba(85, 25, 139, 0.08);
    }

    .auth-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 6px;
    }

    .auth-subtitle {
      font-size: 13px;
      color: var(--text-sub);
      line-height: 1.5;
      margin-bottom: 26px;
    }

    .auth-form {
      text-align: left;
    }

    .auth-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .auth-input {
      width: 100%;
      padding-right: 44px !important;
    }

    .auth-eye-btn {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
    }

    .auth-eye-btn:hover {
      color: var(--text-main);
    }

    .auth-error {
      background: var(--danger-soft);
      color: var(--danger);
      padding: 10px 14px;
      border-radius: var(--radius-md);
      font-size: 12.5px;
      font-weight: 600;
      margin-top: 14px;
      border: 1px solid rgba(220, 38, 38, 0.2);
    }

    .auth-submit-btn {
      width: 100%;
      height: 44px;
      margin-top: 20px;
      justify-content: center;
      font-size: 14px;
    }

    .auth-back-link {
      display: block;
      text-align: center;
      margin-top: 20px;
      font-size: 12.5px;
      color: var(--text-sub);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .auth-back-link:hover {
      color: var(--primary);
    }
  </style>
</head>
<body class="is-locked">

  <!-- SECURITY AUTHENTICATION GATEWAY -->
  <div id="authGate" class="auth-gate" data-default-hash={DEFAULT_PASS_HASH}>
    <div class="auth-card">
      <div class="auth-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2 class="auth-title">Admin Panel Authentication</h2>
      <p class="auth-subtitle">Akses khusus pengelola portofolio Anisah Rihadatul Aisy.</p>

      <form id="authForm" class="auth-form" onsubmit="return false;">
        <div class="form-group">
          <label for="adminAuthPassword">Password / Passcode Admin</label>
          <div class="auth-input-wrapper">
            <input 
              type="password" 
              id="adminAuthPassword" 
              class="input auth-input" 
              placeholder="Masukkan password admin..." 
              autocomplete="current-password"
              required 
            />
            <button type="button" id="toggleAuthEye" class="auth-eye-btn" aria-label="Toggle password visibility">
              <svg id="eyeShow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg id="eyeHide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
        </div>

        <div id="authErrorMsg" class="auth-error" style="display: none;"></div>

        <button type="submit" id="authSubmitBtn" class="btn btn-primary auth-submit-btn">
          <span>Masuk ke Admin Panel</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>

        <a href={baseUrl} class="auth-back-link">
          ← Kembali ke Halaman Portofolio Utama
        </a>
      </form>
    </div>
  </div>

  <aside class="sidebar">
    <div>
      <div class="brand">
        <h2>&lt;Anisah CMS /&gt;</h2>
        <p>Full CRUD Portfolio Manager</p>
      </div>
      <ul class="nav-list">
        <li><button class="nav-btn active" data-sec="hero"><span>01. Welcoming & Foto</span><span class="count-badge">Hero</span></button></li>
        <li><button class="nav-btn" data-sec="skills"><span>02. Skills & Level Bar</span><span class="count-badge" id="cnt-skills">5</span></button></li>
        <li><button class="nav-btn" data-sec="exp"><span>03. Work Experiences</span><span class="count-badge" id="cnt-exp">6</span></button></li>
        <li><button class="nav-btn" data-sec="certs"><span>04. Education & Certs</span><span class="count-badge" id="cnt-certs">7</span></button></li>
        <li><button class="nav-btn" data-sec="pubs"><span>05. Publications & Link</span><span class="count-badge" id="cnt-pubs">6</span></button></li>
        <li><button class="nav-btn" data-sec="projects"><span>06. Projects & Data</span><span class="count-badge" id="cnt-projects">4</span></button></li>
        <li><button class="nav-btn" data-sec="acc"><span>07. Accounts & Kontak</span><span class="count-badge" id="cnt-acc">5</span></button></li>
      </ul>
    </div>
    <div style="font-size: 12px; color: var(--text-sub); border-top: 1px solid var(--border); padding-top: 12px; display:flex; flex-direction:column; gap:8px;">
      <div>Ekspor file <code>portfolioData.json</code> kapan saja untuk commit permanen ke GitHub.</div>
      <button class="btn btn-outline" id="sidebarLogoutBtn" style="color:var(--danger); border-color:var(--danger-soft); width:100%; justify-content:center; padding:7px 10px; font-size:12px;">Keluar / Logout</button>
    </div>
  </aside>

  <div class="workspace">
    <header class="topbar">
      <span class="status-chip">Live Local & Repository JSON Sync Ready</span>
      <div class="top-actions">
        <a href={baseUrl} class="btn btn-outline">Lihat Halaman Publik</a>
        <button class="btn btn-outline" id="changePasswordBtn">Ganti Password</button>
        <button class="btn btn-outline" id="resetDefaultBtn">Reset Default</button>
        <button class="btn btn-primary" id="exportJsonBtn">Export portfolioData.json</button>
        <button class="btn btn-outline" id="adminLogoutBtn" style="color:var(--danger); border-color:var(--danger-soft);">Logout</button>
      </div>
    </header>

    <main class="content">
      <!-- SECTION 1: HERO & WELCOMING -->
      <section id="sec-hero" class="cms-sec active">
        <div class="sec-head">
          <div>
            <h1>01. Pengaturan Halaman Welcoming & Foto Cutout</h1>
            <p>Ubah kalimat sambutan, badge, URL/upload foto profil transparan (blank background), dan tautan CV.</p>
          </div>
          <button class="btn btn-primary" id="saveHeroBtn">Simpan Perubahan Hero</button>
        </div>

        <div class="grid-2">
          <div class="card">
            <div>
              <span class="pill">TEKS WELCOMING</span>
              <div class="form-group" style="margin-top: 14px;">
                <label>Nama Signature di Logo Navbar</label>
                <input id="inpSig" class="input" />
              </div>
              <div class="form-group">
                <label>Badge Atas Judul</label>
                <input id="inpBadge" class="input" />
              </div>
              <div class="form-group">
                <label>Judul Welcoming Utama</label>
                <input id="inpTitle" class="input" />
              </div>
              <div class="form-group">
                <label>Deskripsi Welcoming</label>
                <textarea id="inpSub" class="textarea" rows="4"></textarea>
              </div>
            </div>
          </div>

          <div class="card">
            <div>
              <span class="pill">FOTO TRANSPARAN & FILE CV</span>
              <div class="form-group" style="margin-top: 14px;">
                <label>Upload Foto PNG/WebP Transparan (Otomatis Konversi Data URL)</label>
                <input type="file" id="inpPhotoFile" class="input" accept="image/png,image/webp,image/svg+xml" />
              </div>
              <div class="form-group">
                <label>Atau Path / URL Foto Profil</label>
                <input id="inpPhotoUrl" class="input" />
              </div>
              <div class="grid-2">
                <div class="form-group">
                  <label>Floating Badge Kanan Atas</label>
                  <input id="inpFloatR" class="input" />
                </div>
                <div class="form-group">
                  <label>Floating Badge Kiri Bawah</label>
                  <input id="inpFloatL" class="input" />
                </div>
              </div>
              <div class="form-group">
                <label>URL / Path File Resume PDF</label>
                <input id="inpResumeUrl" class="input" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 2: SKILLS & 5-LEVEL BAR -->
      <section id="sec-skills" class="cms-sec">
        <div class="sec-head">
          <div>
            <h1>02. Kompetensi & Level Bar Putus-putus (5 Tingkat)</h1>
            <p>Klik Edit pada kartu mana saja untuk mengubah nama kompetensi atau levelnya (Beginner s/d Expert).</p>
          </div>
          <button class="btn btn-primary" id="addSkillBtn">+ Tambah Kompetensi</button>
        </div>
        <div class="grid-2" id="adminSkillsGrid"></div>
      </section>

      <!-- SECTION 3: WORK EXPERIENCES -->
      <section id="sec-exp" class="cms-sec">
        <div class="sec-head">
          <div>
            <h1>03. Work & Laboratory Experiences</h1>
            <p>Semua kartu pengalaman kerja, magang QC, dan asistensi lab diurutkan otomatis dari yang terbaru (kiri atas) ke terlama (kanan bawah).</p>
          </div>
          <button class="btn btn-primary" id="addExpBtn">+ Tambah Card Pengalaman</button>
        </div>
        <div class="grid-3" id="adminExpGrid"></div>
      </section>

      <!-- SECTION 4: EDUCATION & CERTIFICATIONS -->
      <section id="sec-certs" class="cms-sec">
        <div class="sec-head">
          <div>
            <h1>04. Education & Certification Cards</h1>
            <p>Bulan & Tahun Terbit wajib diisi. Kartu sertifikasi otomatis diurutkan dari terbaru ke terlama.</p>
          </div>
          <button class="btn btn-primary" id="addCertBtn">+ Tambah Card Sertifikat</button>
        </div>
        <div class="card" style="margin-bottom: 22px; border-left: 4px solid var(--primary);" id="adminEduCard"></div>
        <div class="grid-3" id="adminCertsGrid"></div>
      </section>

      <!-- SECTION 5: PUBLICATIONS & EXTERNAL ARTICLES -->
      <section id="sec-pubs" class="cms-sec">
        <div class="sec-head">
          <div>
            <h1>05. Publications & Artikel Situs Lain (Redirect URL)</h1>
            <p>Kelola kartu Publikasi Ilmiah dan Artikel Eksternal, terurut kronologis dari yang terbaru ke terlama.</p>
          </div>
          <button class="btn btn-primary" id="addPubBtn">+ Tambah Publikasi / Artikel</button>
        </div>
        <div class="grid-2" id="adminPubsGrid"></div>
      </section>

      <!-- SECTION 6: PROJECTS & DATA ACCESS LINKS -->
      <section id="sec-projects" class="cms-sec">
        <div class="sec-head">
          <div>
            <h1>06. Projects & Data Access Links</h1>
            <p>Kelola kartu Project beserta deskripsi dan tautan akses data, terurut kronologis dari project terbaru ke terlama.</p>
          </div>
          <button class="btn btn-primary" id="addProjectBtn">+ Tambah Project</button>
        </div>
        <div class="grid-2" id="adminProjectsGrid"></div>
      </section>

      <!-- SECTION 7: ACCOUNTS & CONTACT -->
      <section id="sec-acc" class="cms-sec">
        <div class="sec-head">
          <div>
            <h1>07. Accounts & Direct Contact Cards</h1>
            <p>Kelola kartu Email, LinkedIn, Nomor Telepon/WhatsApp, Google Scholar, dan Situs Artikel.</p>
          </div>
          <button class="btn btn-primary" id="addAccBtn">+ Tambah Akun Baru</button>
        </div>
        <div class="grid-3" id="adminAccGrid"></div>
      </section>
    </main>
  </div>

  <!-- MODAL UNIVERSAL UNTUK CREATE & UPDATE -->
  <div class="modal-backdrop" id="crudModal">
    <div class="modal-box">
      <div class="modal-head">
        <h3 id="modalTitle">Edit Item</h3>
        <button class="btn btn-outline" id="closeModalBtn">Tutup</button>
      </div>
      <div id="modalFormContainer"></div>
    </div>
  </div>

  <div class="toast" id="toastEl"></div>

  <script id="default-json" type="application/json" set:html={JSON.stringify(initialData)}></script>

  <script>
    import {
      sortAllCollections,
      formatYearMonthToIndo
    } from '../utils/chronologicalSort.js';

    const STORAGE_KEY = 'anisah_portfolio_cms_data_v1';
    const LEVEL_LABELS = { 1: 'Beginner', 2: 'Intermediate', 3: 'Advanced', 4: 'Professional', 5: 'Expert' };

    let state = loadState();

    function loadState() {
      const fallback = JSON.parse(document.getElementById('default-json').textContent);
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : fallback;
        // Defensive: ensure projects array exists for backward compatibility
        if (!parsed.projects || !Array.isArray(parsed.projects)) {
          parsed.projects = fallback.projects || [];
        }
        sortAllCollections(parsed);
        return parsed;
      } catch {
        sortAllCollections(fallback);
        return fallback;
      }
    }

    async function autoSyncToGitHub(stateData) {
      const token = localStorage.getItem('anisah_github_token');
      const repo = localStorage.getItem('anisah_github_repo');
      const branch = localStorage.getItem('anisah_github_branch') || 'main';
      const path = 'src/data/portfolioData.json';

      if (!token || !repo) return;

      try {
        const apiUrl = `https://api.github.com/repos/${repo}/contents/${path}`;
        const getRes = await fetch(apiUrl + `?ref=${branch}`, {
          headers: {
            'Authorization': `Bearer ${token}`,
            'Accept': 'application/vnd.github.v3+json'
          }
        });

        let sha = '';
        if (getRes.ok) {
          const fileData = await getRes.json();
          sha = fileData.sha;
        }

        const contentStr = JSON.stringify(stateData, null, 2);
        const bytes = new TextEncoder().encode(contentStr);
        let binary = '';
        for (let i = 0; i < bytes.length; i++) {
          binary += String.fromCharCode(bytes[i]);
        }
        const b64Content = btoa(binary);

        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            message: 'auto-sync: update portfolioData.json from Admin Panel',
            content: b64Content,
            sha: sha || undefined,
            branch
          })
        });

        if (putRes.ok) {
          showToast('Sinkronisasi otomatis ke GitHub Repository berhasil!');
        } else {
          console.warn('GitHub Auto-Sync response status:', putRes.status);
        }
      } catch (err) {
        console.warn('GitHub Auto-Sync error:', err);
      }
    }

    function persistState(msg = 'Perubahan berhasil disimpan!') {
      sortAllCollections(state);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      if (typeof autoSyncToGitHub === 'function') {
        try {
          autoSyncToGitHub(state);
        } catch (err) {
          console.warn('Auto-sync execution error:', err);
        }
      }
      renderAdmin();
      showToast(msg);
    }

    function showToast(text) {
      const t = document.getElementById('toastEl');
      t.textContent = text;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2600);
    }

    function renderAdmin() {
      // Hero Form
      document.getElementById('inpSig').value = state.hero.signature;
      document.getElementById('inpBadge').value = state.hero.badge;
      document.getElementById('inpTitle').value = state.hero.greetingTitle;
      document.getElementById('inpSub').value = state.hero.greetingSubtitle;
      document.getElementById('inpPhotoUrl').value = state.hero.portraitUrl;
      document.getElementById('inpFloatR').value = state.hero.floatingBadgeRight;
      document.getElementById('inpFloatL').value = state.hero.floatingBadgeLeft;
      document.getElementById('inpResumeUrl').value = state.hero.resumeUrl;

      // Counts
      document.getElementById('cnt-skills').textContent = state.competencies.length;
      document.getElementById('cnt-exp').textContent = state.experiences.length;
      document.getElementById('cnt-certs').textContent = state.certifications.length;
      document.getElementById('cnt-pubs').textContent = state.publications.length;
      document.getElementById('cnt-projects').textContent = state.projects.length;
      document.getElementById('cnt-acc').textContent = state.accounts.length;

      // 2. Skills
      document.getElementById('adminSkillsGrid').innerHTML = state.competencies.map(item => {
        let dashes = '';
        for (let i = 1; i <= 5; i++) {
          dashes += `<div class="seg-dash ${i <= item.level ? 'filled' : ''}"></div>`;
        }
        return `
          <div class="card">
            <div>
              <div style="display:flex; justify-content:space-between;">
                <span class="pill">Level ${item.level} / 5</span>
                <strong style="font-size:12px; color:var(--primary); text-transform:uppercase;">${LEVEL_LABELS[item.level]}</strong>
              </div>
              <h3 class="card-title">${item.name}</h3>
              <div class="seg-bar">${dashes}</div>
            </div>
            <div class="card-foot">
              <span style="font-size:12px; color:var(--text-muted);">Label kanan: ${LEVEL_LABELS[item.level]}</span>
              <div>
                <button class="btn btn-edit" onclick="window.editSkill(${item.id})">Edit</button>
                <button class="btn btn-del" onclick="window.delItem('competencies', ${item.id})">Hapus</button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // 3. Experiences
      document.getElementById('adminExpGrid').innerHTML = state.experiences.map(exp => `
        <div class="card">
          <div>
            <div style="height:7px; border-radius:99px; background:${exp.bannerColor || '#55198b'}; margin-bottom:10px;"></div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span class="pill">${exp.company}</span>
              ${exp.isCurrent ? '<span style="font-size:11px; font-weight:700; color:var(--success); background:var(--success-soft); padding:2px 8px; border-radius:99px;">Aktif</span>' : ''}
            </div>
            <h3 class="card-title">${exp.role}</h3>
            <div class="card-meta">${exp.period}</div>
            <p class="card-desc">${exp.summary}</p>
          </div>
          <div class="card-foot">
            <span style="font-size:11.5px; color:var(--text-muted);">${(exp.metrics || []).join(' · ')}</span>
            <div>
              <button class="btn btn-edit" onclick="window.editExp(${exp.id})">Edit</button>
              <button class="btn btn-del" onclick="window.delItem('experiences', ${exp.id})">Hapus</button>
            </div>
          </div>
        </div>
      `).join('');

      // 4. Education & Certifications
      const edList = Array.isArray(state.education) ? state.education : [state.education];
      document.getElementById('adminEduCard').innerHTML = edList.map(ed => `
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
          <div>
            <span class="pill">${ed.period} | IPK ${ed.gpa}</span>
            <h3 class="card-title">${ed.institution} (${ed.degree})</h3>
            <p class="card-desc">Skripsi: ${ed.thesis}</p>
          </div>
          <button class="btn btn-edit" onclick="window.editEdu()">Edit Pendidikan</button>
        </div>
      `).join('');

      document.getElementById('adminCertsGrid').innerHTML = state.certifications.map(c => {
        const expInfo = c.expiryDate ? `Terbit: ${c.issuedDate} | Exp: ${c.expiryDate}` : `Terbit: ${c.issuedDate} (Tanpa Kadaluarsa)`;
        return `
          <div class="card">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <span class="pill">${c.issuer}</span>
                ${c.issuedYearMonth ? `<span style="font-size:11px; font-weight:600; color:var(--primary);">${c.issuedYearMonth}</span>` : ''}
              </div>
              <h3 class="card-title">${c.name}</h3>
              <div class="card-meta">${expInfo}</div>
              <p class="card-desc">${c.detail}</p>
            </div>
            <div class="card-foot">
              <a href="${c.credentialUrl}" target="_blank" style="font-size:12px; color:var(--primary); font-weight:600;">Kredensial</a>
              <div>
                <button class="btn btn-edit" onclick="window.editCert(${c.id})">Edit</button>
                <button class="btn btn-del" onclick="window.delItem('certifications', ${c.id})">Hapus</button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // 5. Publications
      document.getElementById('adminPubsGrid').innerHTML = state.publications.map(p => `
        <div class="card">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span class="pill">${p.type}</span>
              ${p.publishedDate ? `<span style="font-size:11px; font-weight:600; color:var(--primary);">${p.publishedDate}</span>` : ''}
            </div>
            <h3 class="card-title">${p.title}</h3>
            <div class="card-meta">${p.publisher}</div>
            <p class="card-desc">${p.summary}</p>
          </div>
          <div class="card-foot">
            <a href="${p.url}" target="_blank" style="font-size:12px; color:var(--primary); font-weight:600;">Redirect URL</a>
            <div>
              <button class="btn btn-edit" onclick="window.editPub(${p.id})">Edit</button>
              <button class="btn btn-del" onclick="window.delItem('publications', ${p.id})">Hapus</button>
            </div>
          </div>
        </div>
      `).join('');

      // 6. Projects
      document.getElementById('adminProjectsGrid').innerHTML = state.projects.map(proj => `
        <div class="card">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span class="pill">PROJECT</span>
              ${proj.periodLabel ? `<span style="font-size:11px; font-weight:600; color:var(--primary);">${proj.periodLabel}</span>` : ''}
            </div>
            <h3 class="card-title">${proj.title}</h3>
            <div class="card-meta">${proj.projectDate ? 'Waktu: ' + proj.projectDate : ''}</div>
            <p class="card-desc">${proj.description}</p>
          </div>
          <div class="card-foot">
            <a href="${proj.accessUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 5px 12px; font-size: 12px;">
              Access ↗
            </a>
            <div>
              <button class="btn btn-edit" onclick="window.editProject(${proj.id})">Edit</button>
              <button class="btn btn-del" onclick="window.delItem('projects', ${proj.id})">Hapus</button>
            </div>
          </div>
        </div>
      `).join('');

      // 7. Accounts
      document.getElementById('adminAccGrid').innerHTML = state.accounts.map(a => `
        <div class="card">
          <div>
            <span class="pill">${a.category}</span>
            <h3 class="card-title">${a.label}</h3>
            <p class="card-desc" style="word-break:break-all;">${a.url}</p>
          </div>
          <div class="card-foot">
            <a href="${a.url}" target="_blank" style="font-size:12px; color:var(--primary); font-weight:600;">Tes Link</a>
            <div>
              <button class="btn btn-edit" onclick="window.editAcc(${a.id})">Edit</button>
              <button class="btn btn-del" onclick="window.delItem('accounts', ${a.id})">Hapus</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Modal Helpers
    const modal = document.getElementById('crudModal');
    const modalForm = document.getElementById('modalFormContainer');
    const modalTitle = document.getElementById('modalTitle');
    document.getElementById('closeModalBtn').addEventListener('click', () => modal.classList.remove('open'));

    window.delItem = (collection, id) => {
      if (!confirm('Hapus card ini?')) return;
      state[collection] = state[collection].filter(x => x.id !== id);
      persistState('Card berhasil dihapus.');
    };

    // Hero Save & Photo Upload
    document.getElementById('inpPhotoFile').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        document.getElementById('inpPhotoUrl').value = reader.result;
      };
      reader.readAsDataURL(file);
    });

    document.getElementById('saveHeroBtn').addEventListener('click', () => {
      state.hero = {
        signature: document.getElementById('inpSig').value.trim(),
        badge: document.getElementById('inpBadge').value.trim(),
        greetingTitle: document.getElementById('inpTitle').value.trim(),
        greetingSubtitle: document.getElementById('inpSub').value.trim(),
        portraitUrl: document.getElementById('inpPhotoUrl').value.trim(),
        floatingBadgeRight: document.getElementById('inpFloatR').value.trim(),
        floatingBadgeLeft: document.getElementById('inpFloatL').value.trim(),
        resumeUrl: document.getElementById('inpResumeUrl').value.trim()
      };
      persistState('Data halaman Welcoming berhasil disimpan!');
    });

    // Skill Modal
    window.editSkill = (id = null) => {
      const item = id ? state.competencies.find(x => x.id === id) : { name: '', level: 5 };
      modalTitle.textContent = id ? 'Edit Kompetensi' : 'Tambah Kompetensi Baru';
      modalForm.innerHTML = `
        <div class="form-group"><label>Nama Kompetensi *</label><input id="mSkillName" class="input" value="${item.name}" /></div>
        <div class="form-group">
          <label>Level Bar Putus-putus (1 s/d 5) *</label>
          <select id="mSkillLevel" class="select">
            <option value="1" ${item.level === 1 ? 'selected' : ''}>1 - Beginner</option>
            <option value="2" ${item.level === 2 ? 'selected' : ''}>2 - Intermediate</option>
            <option value="3" ${item.level === 3 ? 'selected' : ''}>3 - Advanced</option>
            <option value="4" ${item.level === 4 ? 'selected' : ''}>4 - Professional</option>
            <option value="5" ${item.level === 5 ? 'selected' : ''}>5 - Expert</option>
          </select>
        </div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan</button>
      `;
      modal.classList.add('open');
      document.getElementById('mSaveBtn').onclick = () => {
        const name = document.getElementById('mSkillName').value.trim();
        const level = parseInt(document.getElementById('mSkillLevel').value, 10);
        if (!name) return alert('Nama kompetensi wajib diisi.');
        if (id) {
          const idx = state.competencies.findIndex(x => x.id === id);
          state.competencies[idx] = { id, name, level };
        } else {
          state.competencies.push({ id: Date.now(), name, level });
        }
        modal.classList.remove('open');
        persistState();
      };
    };
    document.getElementById('addSkillBtn').onclick = () => window.editSkill(null);

    // Experience Modal
    window.editExp = (id = null) => {
      const item = id ? state.experiences.find(x => x.id === id) : { company: '', role: '', startDate: '', endDate: '', isCurrent: false, period: '', bannerColor: '#55198b', summary: '', metrics: [] };
      modalTitle.textContent = id ? 'Edit Card Pengalaman' : 'Tambah Card Pengalaman';
      modalForm.innerHTML = `
        <div class="grid-2">
          <div class="form-group"><label>Instansi / Perusahaan *</label><input id="mExpComp" class="input" value="${item.company || ''}" required /></div>
          <div class="form-group"><label>Warna Header Banner</label><input id="mExpColor" class="input" value="${item.bannerColor || '#55198b'}" /></div>
        </div>
        <div class="form-group"><label>Role / Posisi *</label><input id="mExpRole" class="input" value="${item.role || ''}" required /></div>
        <div class="grid-2">
          <div class="form-group">
            <label>Bulan & Tahun Mulai (Wajib) *</label>
            <input type="month" id="mExpStart" class="input" value="${item.startDate || ''}" required />
          </div>
          <div class="form-group">
            <label>Bulan & Tahun Selesai</label>
            <input type="month" id="mExpEnd" class="input" value="${item.endDate && item.endDate !== 'present' ? item.endDate : ''}" ${item.isCurrent ? 'disabled' : ''} />
          </div>
        </div>
        <div class="form-group" style="margin-top:-6px;">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-weight:500;">
            <input type="checkbox" id="mExpCurrent" ${item.isCurrent ? 'checked' : ''} />
            <span>Masih Berlangsung (Sekarang / Ongoing)</span>
          </label>
        </div>
        <div class="form-group">
          <label>Periode Tampil (Otomatis / Kustom) *</label>
          <input id="mExpPeriod" class="input" value="${item.period || ''}" placeholder="Contoh: Feb 2026 – Mei 2026" />
          <small style="color:var(--text-muted); font-size:11.5px;">Otomatis terisi saat memilih bulan, atau sesuaikan bila diperlukan format teks kustom.</small>
        </div>
        <div class="form-group"><label>Ringkasan Pekerjaan *</label><textarea id="mExpSum" class="textarea" rows="3">${item.summary || ''}</textarea></div>
        <div class="form-group"><label>Metrik Utama (Pisahkan dengan koma)</label><input id="mExpMetrics" class="input" value="${(item.metrics || []).join(', ')}" /></div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan Pengalaman</button>
      `;
      modal.classList.add('open');

      const startInput = document.getElementById('mExpStart');
      const endInput = document.getElementById('mExpEnd');
      const currentCheck = document.getElementById('mExpCurrent');
      const periodInput = document.getElementById('mExpPeriod');

      const autoFillExpPeriod = () => {
        const startVal = startInput.value.trim();
        const isCurrent = currentCheck.checked;
        endInput.disabled = isCurrent;

        const startLabel = formatYearMonthToIndo(startVal);
        if (isCurrent) {
          periodInput.value = startLabel ? `${startLabel} – Sekarang` : 'Sekarang';
        } else {
          const endVal = endInput.value.trim();
          const endLabel = formatYearMonthToIndo(endVal);
          if (startLabel && endLabel) {
            periodInput.value = startLabel === endLabel ? startLabel : `${startLabel} – ${endLabel}`;
          } else if (startLabel) {
            periodInput.value = startLabel;
          } else if (endLabel) {
            periodInput.value = endLabel;
          }
        }
      };

      startInput.addEventListener('change', autoFillExpPeriod);
      endInput.addEventListener('change', autoFillExpPeriod);
      currentCheck.addEventListener('change', autoFillExpPeriod);

      document.getElementById('mSaveBtn').onclick = () => {
        const company = document.getElementById('mExpComp').value.trim();
        const role = document.getElementById('mExpRole').value.trim();
        const startDate = startInput.value.trim();
        const isCurrent = currentCheck.checked;
        const endDate = isCurrent ? 'present' : endInput.value.trim();
        let period = periodInput.value.trim();

        if (!company || !role) {
          return alert('Instansi dan Role wajib diisi.');
        }

        if (!period) {
          const startLabel = formatYearMonthToIndo(startDate);
          if (isCurrent) {
            period = startLabel ? `${startLabel} – Sekarang` : 'Sekarang';
          } else {
            const endLabel = formatYearMonthToIndo(endDate);
            period = startLabel && endLabel
              ? (startLabel === endLabel ? startLabel : `${startLabel} – ${endLabel}`)
              : (startLabel || endLabel || '');
          }
        }

        const payload = {
          id: id || Date.now(),
          company,
          role,
          startDate,
          endDate,
          isCurrent,
          period,
          bannerColor: document.getElementById('mExpColor').value.trim() || '#55198b',
          summary: document.getElementById('mExpSum').value.trim(),
          metrics: document.getElementById('mExpMetrics').value.split(',').map(s => s.trim()).filter(Boolean)
        };

        if (id) {
          const idx = state.experiences.findIndex(x => x.id === id);
          state.experiences[idx] = payload;
        } else {
          state.experiences.unshift(payload);
        }
        modal.classList.remove('open');
        persistState('Data pengalaman berhasil disimpan dan diurutkan!');
      };
    };
    document.getElementById('addExpBtn').onclick = () => window.editExp(null);

    // Education Edit
    window.editEdu = () => {
      const ed = Array.isArray(state.education) ? state.education[0] : state.education;
      modalTitle.textContent = 'Edit Pendidikan Utama';
      modalForm.innerHTML = `
        <div class="form-group"><label>Universitas / Institusi *</label><input id="mEduInst" class="input" value="${ed.institution || ''}" /></div>
        <div class="grid-2">
          <div class="form-group"><label>Gelar / Program Studi *</label><input id="mEduDeg" class="input" value="${ed.degree || ''}" /></div>
          <div class="form-group"><label>IPK *</label><input id="mEduGpa" class="input" value="${ed.gpa || ''}" /></div>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label>Bulan & Tahun Mulai</label>
            <input type="month" id="mEduStart" class="input" value="${ed.startDate || ''}" />
          </div>
          <div class="form-group">
            <label>Bulan & Tahun Selesai</label>
            <input type="month" id="mEduEnd" class="input" value="${ed.endDate || ''}" />
          </div>
        </div>
        <div class="form-group"><label>Periode Tampil</label><input id="mEduPer" class="input" value="${ed.period || ''}" /></div>
        <div class="form-group"><label>Judul Skripsi</label><textarea id="mEduTh" class="textarea" rows="2">${ed.thesis || ''}</textarea></div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan Pendidikan</button>
      `;
      modal.classList.add('open');

      const sInp = document.getElementById('mEduStart');
      const eInp = document.getElementById('mEduEnd');
      const pInp = document.getElementById('mEduPer');

      const updateEduPeriod = () => {
        const s = sInp.value.trim();
        const e = eInp.value.trim();
        if (s && e) {
          pInp.value = `${formatYearMonthToIndo(s, false)} – ${formatYearMonthToIndo(e, false)}`;
        }
      };
      sInp.addEventListener('change', updateEduPeriod);
      eInp.addEventListener('change', updateEduPeriod);

      document.getElementById('mSaveBtn').onclick = () => {
        const updated = {
          ...(Array.isArray(state.education) ? state.education[0] : state.education),
          institution: document.getElementById('mEduInst').value.trim(),
          degree: document.getElementById('mEduDeg').value.trim(),
          gpa: document.getElementById('mEduGpa').value.trim(),
          startDate: sInp.value.trim(),
          endDate: eInp.value.trim(),
          period: pInp.value.trim(),
          thesis: document.getElementById('mEduTh').value.trim()
        };
        if (Array.isArray(state.education)) {
          state.education[0] = updated;
        } else {
          state.education = updated;
        }
        modal.classList.remove('open');
        persistState('Data pendidikan berhasil disimpan!');
      };
    };

    // Certification Modal
    window.editCert = (id = null) => {
      const item = id ? state.certifications.find(x => x.id === id) : { name: '', issuer: '', issuedYearMonth: '', expiryYearMonth: '', issuedDate: '', expiryDate: '', detail: '', credentialUrl: 'https://' };
      modalTitle.textContent = id ? 'Edit Card Sertifikat' : 'Tambah Card Sertifikat';
      modalForm.innerHTML = `
        <div class="grid-2">
          <div class="form-group"><label>Nama Sertifikat *</label><input id="mCertName" class="input" value="${item.name || ''}" required /></div>
          <div class="form-group"><label>Issuer (Penerbit) *</label><input id="mCertIssuer" class="input" value="${item.issuer || ''}" required /></div>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label>Bulan & Tahun Terbit (Wajib) *</label>
            <input type="month" id="mCertIssuedYM" class="input" value="${item.issuedYearMonth || ''}" required />
          </div>
          <div class="form-group">
            <label>Bulan & Tahun Kadaluarsa (Opsional)</label>
            <input type="month" id="mCertExpYM" class="input" value="${item.expiryYearMonth || ''}" />
          </div>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label>Label Teks Terbit</label>
            <input id="mCertIssued" class="input" value="${item.issuedDate || ''}" placeholder="Contoh: Mei 2026" />
          </div>
          <div class="form-group">
            <label>Label Teks Kadaluarsa (Opsional)</label>
            <input id="mCertExp" class="input" value="${item.expiryDate || ''}" placeholder="Kosongkan jika seumur hidup" />
          </div>
        </div>
        <div class="form-group"><label>Detail Kompetensi *</label><textarea id="mCertDet" class="textarea" rows="3">${item.detail || ''}</textarea></div>
        <div class="form-group"><label>URL Kredensial *</label><input id="mCertUrl" class="input" value="${item.credentialUrl || 'https://'}" /></div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan Sertifikat</button>
      `;
      modal.classList.add('open');

      const issuedYMInput = document.getElementById('mCertIssuedYM');
      const expYMInput = document.getElementById('mCertExpYM');
      const issuedTextInput = document.getElementById('mCertIssued');
      const expTextInput = document.getElementById('mCertExp');

      issuedYMInput.addEventListener('change', (e) => {
        const val = e.target.value.trim();
        if (val) issuedTextInput.value = formatYearMonthToIndo(val);
      });

      expYMInput.addEventListener('change', (e) => {
        const val = e.target.value.trim();
        expTextInput.value = val ? formatYearMonthToIndo(val) : '';
      });

      document.getElementById('mSaveBtn').onclick = () => {
        const name = document.getElementById('mCertName').value.trim();
        const issuer = document.getElementById('mCertIssuer').value.trim();
        const issuedYearMonth = issuedYMInput.value.trim();
        const expiryYearMonth = expYMInput.value.trim();
        let issuedDate = issuedTextInput.value.trim();
        let expiryDate = expTextInput.value.trim();

        if (!name || !issuer) {
          return alert('Nama sertifikat dan Issuer wajib diisi.');
        }

        if (!issuedYearMonth && !issuedDate) {
          return alert('Bulan & Tahun Terbit wajib diisi.');
        }

        if (!issuedDate && issuedYearMonth) {
          issuedDate = formatYearMonthToIndo(issuedYearMonth);
        }
        if (!expiryDate && expiryYearMonth) {
          expiryDate = formatYearMonthToIndo(expiryYearMonth);
        }

        const payload = {
          id: id || Date.now(),
          name,
          issuer,
          issuedYearMonth,
          expiryYearMonth,
          issuedDate,
          expiryDate,
          detail: document.getElementById('mCertDet').value.trim(),
          credentialUrl: document.getElementById('mCertUrl').value.trim() || 'https://'
        };

        if (id) {
          const idx = state.certifications.findIndex(x => x.id === id);
          state.certifications[idx] = payload;
        } else {
          state.certifications.unshift(payload);
        }
        modal.classList.remove('open');
        persistState('Data sertifikat berhasil disimpan dan diurutkan!');
      };
    };
    document.getElementById('addCertBtn').onclick = () => window.editCert(null);

    // Publication / Article Modal
    window.editPub = (id = null) => {
      const item = id ? state.publications.find(x => x.id === id) : { type: 'Publikasi Ilmiah', title: '', publisher: '', publishedDate: '', summary: '', url: 'https://' };
      modalTitle.textContent = id ? 'Edit Publikasi / Artikel' : 'Tambah Publikasi / Artikel';
      modalForm.innerHTML = `
        <div class="grid-2">
          <div class="form-group">
            <label>Kategori *</label>
            <select id="mPubType" class="select">
              <option value="Publikasi Ilmiah" ${item.type === 'Publikasi Ilmiah' ? 'selected' : ''}>Publikasi Ilmiah</option>
              <option value="Artikel Eksternal" ${item.type === 'Artikel Eksternal' ? 'selected' : ''}>Artikel Eksternal</option>
            </select>
          </div>
          <div class="form-group">
            <label>Bulan & Tahun Publikasi / Penghargaan *</label>
            <input type="month" id="mPubDate" class="input" value="${item.publishedDate || ''}" required />
          </div>
        </div>
        <div class="form-group"><label>Penerbit / Penyelenggara & Tahun *</label><input id="mPubMeta" class="input" value="${item.publisher || ''}" placeholder="Contoh: Gold Medal NASPO · 2024" required /></div>
        <div class="form-group"><label>Judul Publikasi / Artikel *</label><input id="mPubTitle" class="input" value="${item.title || ''}" required /></div>
        <div class="form-group"><label>Ringkasan *</label><textarea id="mPubSum" class="textarea" rows="3">${item.summary || ''}</textarea></div>
        <div class="form-group"><label>Redirect URL (Dibuka saat kartu diklik) *</label><input id="mPubUrl" class="input" value="${item.url || 'https://'}" required /></div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan Publikasi / Artikel</button>
      `;
      modal.classList.add('open');
      document.getElementById('mSaveBtn').onclick = () => {
        const title = document.getElementById('mPubTitle').value.trim();
        const url = document.getElementById('mPubUrl').value.trim();
        const publishedDate = document.getElementById('mPubDate').value.trim();

        if (!title || !url) return alert('Judul dan URL Redirect wajib diisi.');

        const payload = {
          id: id || Date.now(),
          type: document.getElementById('mPubType').value,
          title,
          publisher: document.getElementById('mPubMeta').value.trim(),
          publishedDate,
          summary: document.getElementById('mPubSum').value.trim(),
          url
        };

        if (id) {
          const idx = state.publications.findIndex(x => x.id === id);
          state.publications[idx] = payload;
        } else {
          state.publications.unshift(payload);
        }
        modal.classList.remove('open');
        persistState('Data publikasi berhasil disimpan dan diurutkan!');
      };
    };
    document.getElementById('addPubBtn').onclick = () => window.editPub(null);

    // Project Modal
    window.editProject = (id = null) => {
      const item = id ? state.projects.find(x => x.id === id) : { title: '', projectDate: '', periodLabel: '', description: '', accessUrl: 'https://drive.google.com/' };
      modalTitle.textContent = id ? 'Edit Project' : 'Tambah Project Baru';
      modalForm.innerHTML = `
        <div class="grid-2">
          <div class="form-group"><label>Judul Project *</label><input id="mProjTitle" class="input" value="${item.title || ''}" placeholder="Masukkan judul project" required /></div>
          <div class="form-group">
            <label>Bulan & Tahun Project *</label>
            <input type="month" id="mProjDate" class="input" value="${item.projectDate || ''}" required />
          </div>
        </div>
        <div class="form-group">
          <label>Label Periode Tampil (Otomatis / Kustom)</label>
          <input id="mProjPeriod" class="input" value="${item.periodLabel || ''}" placeholder="Contoh: Des 2025" />
          <small style="color:var(--text-muted); font-size:11.5px;">Otomatis terisi saat memilih bulan, atau sesuaikan bila diperlukan.</small>
        </div>
        <div class="form-group"><label>Deskripsi Project *</label><textarea id="mProjDesc" class="textarea" rows="4" placeholder="Masukkan deskripsi singkat project">${item.description || ''}</textarea></div>
        <div class="form-group"><label>Redirect Link Tombol "Access" (Drive / Data Project) *</label><input id="mProjUrl" class="input" value="${item.accessUrl || 'https://drive.google.com/'}" placeholder="https://drive.google.com/..." required /></div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan Project</button>
      `;
      modal.classList.add('open');

      const projDateInput = document.getElementById('mProjDate');
      const projPeriodInput = document.getElementById('mProjPeriod');

      projDateInput.addEventListener('change', (e) => {
        const val = e.target.value.trim();
        if (val) projPeriodInput.value = formatYearMonthToIndo(val);
      });

      document.getElementById('mSaveBtn').onclick = () => {
        const title = document.getElementById('mProjTitle').value.trim();
        const description = document.getElementById('mProjDesc').value.trim();
        const accessUrl = document.getElementById('mProjUrl').value.trim();
        const projectDate = projDateInput.value.trim();
        let periodLabel = projPeriodInput.value.trim();

        if (!title || !description || !accessUrl) {
          return alert('Judul, Deskripsi, dan URL Access wajib diisi.');
        }

        if (!periodLabel && projectDate) {
          periodLabel = formatYearMonthToIndo(projectDate);
        }

        const payload = {
          id: id || Date.now(),
          title,
          projectDate,
          periodLabel,
          description,
          accessUrl
        };

        if (id) {
          const idx = state.projects.findIndex(x => x.id === id);
          state.projects[idx] = payload;
        } else {
          state.projects.unshift(payload);
        }
        modal.classList.remove('open');
        persistState('Data project berhasil disimpan dan diurutkan!');
      };
    };
    document.getElementById('addProjectBtn').onclick = () => window.editProject(null);

    // Account Modal
    window.editAcc = (id = null) => {
      const item = id ? state.accounts.find(x => x.id === id) : { category: '', label: '', url: '' };
      modalTitle.textContent = id ? 'Edit Akun & Kontak' : 'Tambah Akun Baru';
      modalForm.innerHTML = `
        <div class="form-group"><label>Kategori Akun (Email / LinkedIn / No. Telp / Publikasi) *</label><input id="mAccCat" class="input" value="${item.category}" /></div>
        <div class="form-group"><label>Label Tampil *</label><input id="mAccLbl" class="input" value="${item.label}" /></div>
        <div class="form-group"><label>URL / mailto: / tel: *</label><input id="mAccUrl" class="input" value="${item.url}" /></div>
        <button class="btn btn-primary" id="mSaveBtn" style="width:100%; justify-content:center;">Simpan Akun</button>
      `;
      modal.classList.add('open');
      document.getElementById('mSaveBtn').onclick = () => {
        const payload = {
          id: id || Date.now(),
          category: document.getElementById('mAccCat').value.trim(),
          label: document.getElementById('mAccLbl').value.trim(),
          url: document.getElementById('mAccUrl').value.trim()
        };
        if (!payload.category || !payload.label) return alert('Data akun wajib dilengkapi.');
        if (id) {
          const idx = state.accounts.findIndex(x => x.id === id);
          state.accounts[idx] = payload;
        } else {
          state.accounts.push(payload);
        }
        modal.classList.remove('open');
        persistState();
      };
    };
    document.getElementById('addAccBtn').onclick = () => window.editAcc(null);

    // Export JSON & Reset
    document.getElementById('exportJsonBtn').onclick = () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'portfolioData.json';
      a.click();
    };

    document.getElementById('resetDefaultBtn').onclick = () => {
      if (!confirm('Kembalikan semua data ke bawaan awal?')) return;
      localStorage.removeItem(STORAGE_KEY);
      state = loadState();
      renderAdmin();
      showToast('Data dikembalikan ke pengaturan awal.');
    };

    // Sidebar Navigation
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cms-sec').forEach(s => s.classList.remove('active'));
        document.getElementById('sec-' + btn.getAttribute('data-sec')).classList.add('active');
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    renderAdmin();

    // ==========================================
    // SECURITY & AUTHENTICATION GATEWAY LOGIC
    // ==========================================
    const AUTH_SESSION_KEY = 'anisah_admin_authenticated';
    const CUSTOM_HASH_KEY = 'anisah_admin_custom_hash';
    const DEFAULT_HASH = document.getElementById('authGate').getAttribute('data-default-hash');
    const MAX_ATTEMPTS = 3;
    let failedAttempts = 0;
    let lockoutTimer = null;

    async function sha256(text) {
      const buffer = new TextEncoder().encode(text);
      const digest = await crypto.subtle.digest('SHA-256', buffer);
      return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    function checkAuthStatus() {
      const isAuth = sessionStorage.getItem(AUTH_SESSION_KEY) === 'true';
      if (isAuth) {
        document.body.classList.remove('is-locked');
      } else {
        document.body.classList.add('is-locked');
        setTimeout(() => {
          const inp = document.getElementById('adminAuthPassword');
          if (inp) inp.focus();
        }, 120);
      }
    }

    async function handleLogin() {
      const pwdInput = document.getElementById('adminAuthPassword');
      const errBox = document.getElementById('authErrorMsg');
      const submitBtn = document.getElementById('authSubmitBtn');
      const enteredPwd = pwdInput.value;

      if (!enteredPwd) {
        errBox.textContent = 'Silakan masukkan password admin terlebih dahulu.';
        errBox.style.display = 'block';
        return;
      }

      const enteredHash = await sha256(enteredPwd);
      const expectedHash = localStorage.getItem(CUSTOM_HASH_KEY) || DEFAULT_HASH;

      if (enteredHash === expectedHash) {
        sessionStorage.setItem(AUTH_SESSION_KEY, 'true');
        errBox.style.display = 'none';
        pwdInput.value = '';
        failedAttempts = 0;
        document.body.classList.remove('is-locked');
        showToast('Login berhasil. Selamat datang di Admin Panel!');
      } else {
        failedAttempts++;
        pwdInput.value = '';
        pwdInput.focus();

        if (failedAttempts >= MAX_ATTEMPTS) {
          let secondsLeft = 30;
          submitBtn.disabled = true;
          pwdInput.disabled = true;
          errBox.textContent = `Terlalu banyak percobaan salah. Coba lagi dalam ${secondsLeft} detik.`;
          errBox.style.display = 'block';

          lockoutTimer = setInterval(() => {
            secondsLeft--;
            if (secondsLeft <= 0) {
              clearInterval(lockoutTimer);
              failedAttempts = 0;
              submitBtn.disabled = false;
              pwdInput.disabled = false;
              errBox.style.display = 'none';
              pwdInput.focus();
            } else {
              errBox.textContent = `Terlalu banyak percobaan salah. Coba lagi dalam ${secondsLeft} detik.`;
            }
          }, 1000);
        } else {
          errBox.textContent = `Password salah. Akses ditolak (${failedAttempts}/${MAX_ATTEMPTS} percobaan).`;
          errBox.style.display = 'block';
        }
      }
    }

    // Toggle Eye Password
    document.getElementById('toggleAuthEye').addEventListener('click', () => {
      const pwdInput = document.getElementById('adminAuthPassword');
      const eyeShow = document.getElementById('eyeShow');
      const eyeHide = document.getElementById('eyeHide');
      const isPass = pwdInput.type === 'password';
      pwdInput.type = isPass ? 'text' : 'password';
      eyeShow.style.display = isPass ? 'none' : 'block';
      eyeHide.style.display = isPass ? 'block' : 'none';
    });

    document.getElementById('authForm').addEventListener('submit', (e) => {
      e.preventDefault();
      handleLogin();
    });

    // Logout
    function handleLogout() {
      if (!confirm('Apakah Anda yakin ingin keluar dari Admin Panel?')) return;
      sessionStorage.removeItem(AUTH_SESSION_KEY);
      document.body.classList.add('is-locked');
      const pwdInput = document.getElementById('adminAuthPassword');
      if (pwdInput) {
        pwdInput.value = '';
        pwdInput.focus();
      }
      showToast('Anda telah logout dari Admin Panel.');
    }

    document.getElementById('adminLogoutBtn').addEventListener('click', handleLogout);
    const sidebarLogout = document.getElementById('sidebarLogoutBtn');
    if (sidebarLogout) sidebarLogout.addEventListener('click', handleLogout);

    // Change Password Modal
    document.getElementById('changePasswordBtn').addEventListener('click', () => {
      modalTitle.textContent = 'Ganti Password Admin Panel';
      modalForm.innerHTML = `
        <div class="form-group">
          <label>Password Baru *</label>
          <input type="password" id="mNewPass" class="input" placeholder="Minimal 6 karakter" />
        </div>
        <div class="form-group">
          <label>Konfirmasi Password Baru *</label>
          <input type="password" id="mConfirmPass" class="input" placeholder="Ketik ulang password baru" />
        </div>
        <div style="display:flex; gap:10px; margin-top:20px;">
          <button class="btn btn-primary" id="mSavePassBtn" style="flex:1; justify-content:center;">Simpan Password Baru</button>
          <button class="btn btn-outline" id="mResetPassBtn" style="color:var(--text-sub);">Reset Bawaan</button>
        </div>
      `;
      modal.classList.add('open');

      document.getElementById('mSavePassBtn').onclick = async () => {
        const p1 = document.getElementById('mNewPass').value;
        const p2 = document.getElementById('mConfirmPass').value;
        if (!p1 || p1.length < 6) return alert('Password minimal harus 6 karakter.');
        if (p1 !== p2) return alert('Konfirmasi password tidak cocok.');

        const newHash = await sha256(p1);
        localStorage.setItem(CUSTOM_HASH_KEY, newHash);
        modal.classList.remove('open');
        showToast('Password admin berhasil diperbarui!');
      };

      document.getElementById('mResetPassBtn').onclick = () => {
        if (!confirm('Kembalikan password ke bawaan sistem?')) return;
        localStorage.removeItem(CUSTOM_HASH_KEY);
        modal.classList.remove('open');
        showToast('Password dikembalikan ke bawaan sistem.');
      };
    });

    // Check auth state immediately
    checkAuthStatus();
  </script>
</body>
</html>
